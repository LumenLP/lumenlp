[Unit]
Description=LP Agent multi-DEX pool indexer (Aquarius + Soroswap event ingest)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lpagent
Environment=RPC_URL=http://127.0.0.1:8003
Environment=INDEXER_DB_PATH=/opt/lpagent/data/pool-indexer.db
Environment=INDEXER_POLL_SECS=30
Environment=INDEXER_VENUES=aquarius,soroswap
Environment=RUST_LOG=info
ExecStart=/opt/lpagent/target/release/pool-indexer run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target

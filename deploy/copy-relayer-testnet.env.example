# Copy relayer configuration. Keep the real file at
# /etc/lumenlp/copy-relayer-testnet.env and never commit signer secrets.
COPY_POLICY=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
COPY_RECORDER_ACCOUNT=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
COPY_RELAYER_ACCOUNT=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
COPY_INDEX_DB_PATH=/opt/lumenlp/data/pool-indexer.db

# The script refuses mainnet and zero-min-output writes unless these are
# explicit. This example is testnet-only; review the policy fixture first.
RUN_WRITE=0
COPY_ALLOW_ZERO_MIN_OUTPUTS=0

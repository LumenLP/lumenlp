[Unit]
Description=LumenLP multi-DEX pool indexer (Aquarius + Soroswap + Phoenix + Sushi + Comet ingest)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/lumenlp
Environment=RPC_URL=http://127.0.0.1:8003
Environment=INDEXER_DB_PATH=/opt/lumenlp/data/pool-indexer.db
Environment=SNAPSHOT_DATABASE_PATH=/opt/lumenlp/data/lumenlp.db
Environment=INDEXER_POLL_SECS=30
Environment=INDEXER_VENUES=aquarius,soroswap,phoenix,sushi,comet
Environment=RUST_LOG=info
ExecStart=/opt/lumenlp/target/release/pool-indexer run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
